# Copy to .env.local and fill in. Local file is gitignored.
# For deployed envs (Coolify), set these in the Coolify env panel.

# ===== REQUIRED =====

# Postgres on M90t — same string as ~/evergreen-core/.env.local
DATABASE_URL=

# Better Auth secret — same value as EC's BETTER_AUTH_SECRET. This is what
# makes shared sessions work; if it differs, LifeOS can't validate EC's cookies.
BETTER_AUTH_SECRET=

# Local dev: http://localhost:3001
# Production:  https://lifeos.evergreenwellnessmktg.com
NEXT_PUBLIC_APP_URL=http://localhost:3001

# EC's URL — used as a trusted origin and for the redirect-to-sign-in fallback.
# Local dev:  http://localhost:3000
# Production: https://app.evergreenwellnessmktg.com
NEXT_PUBLIC_EC_URL=https://app.evergreenwellnessmktg.com

# ===== PRODUCTION-ONLY =====

# Set this on Coolify to enable cross-subdomain cookies between
# app.evergreenwellnessmktg.com and lifeos.evergreenwellnessmktg.com.
# Leave UNSET for local dev (cross-port localhost cookies don't need it).
# EC must have the same value set on its prod env.
# BETTER_AUTH_COOKIE_DOMAIN=.evergreenwellnessmktg.com

# Comma-separated list of additional trusted origins for Better Auth.
# Useful when an extra deploy preview URL needs to validate sessions.
# BETTER_AUTH_TRUSTED_ORIGINS=https://lifeos-staging.evergreenwellnessmktg.com

# ===== OPTIONAL — AI COACH =====

# OpenAI-compatible LLM endpoint for /coach. Defaults to localhost Ollama.
# Examples:
#   http://192.168.4.200:11434/v1   (Ollama on M90t)
#   http://192.168.4.180:11434/v1   (Ollama on Framestation)
#   http://localhost:11434/v1       (Ollama on M4)
# LIFEOS_LLM_BASE_URL=http://192.168.4.200:11434/v1
# LIFEOS_LLM_API_KEY=ollama
# LIFEOS_LLM_MODEL=qwen2.5:32b

# ---------------------------------------------------------------------
# Household gate (required if you use /pick-profile)
# ---------------------------------------------------------------------
# A shared code for this house. /pick-profile and the profile switch
# endpoint stay shut until a device has entered it once, after which
# that device stays unlocked for a month.
#
# This fails closed on purpose: with nothing set here, nobody can pick a
# profile at all. Signing in by email link still works and does not need
# the code.
#
# Four characters minimum. Anything you would not mind a houseguest
# seeing you type.
LIFEOS_HOUSEHOLD_CODE=

# ---------------------------------------------------------------------
# The household itself (required if you use /pick-profile)
# ---------------------------------------------------------------------
# Who this copy of LifeOS knows about. A JSON array, one object per
# person. This used to be a hardcoded list in lib/profiles/config.ts,
# which meant adding someone was a code change and real email addresses
# of real people lived in the repository.
#
# slug   required  the value stored in the profile cookie. 1 to 32
#                  lowercase letters, digits or hyphens.
# name   required  what shows on the picker. 1 to 40 characters.
# email  required  how the profile resolves to a user row. A profile
#                  whose email matches an existing user re-uses that
#                  user and its whole log, so to carry someone over
#                  from a previous deploy, use the same address.
# accent optional  violet, rose, sky, green or gold. Defaults to the
#                  next one in that order. The fluorescent spot ink is
#                  not on the list; it means live, today, now.
# initial optional one character for the avatar square. Defaults to the
#                  first letter of the name.
#
# Fails closed, like the household code above. Unset or malformed and
# the registry is empty, the picker shows nobody and explains why, and
# the reason is logged at startup. A bad entry rejects the whole list
# rather than quietly dropping one person.
#
# Keep it on one line. Most hosts, Coolify included, do not accept
# newlines in an environment value.
LIFEOS_PROFILES=[{"slug":"sam","name":"Sam","email":"sam@example.com","accent":"violet"},{"slug":"ada","name":"Ada","email":"ada@example.com","accent":"rose"}]

# ---------------------------------------------------------------------
# The household's time zone
# ---------------------------------------------------------------------
# Every check-in, habit completion, journal entry and protocol run is
# filed under a calendar day, and this decides which calendar. An IANA
# zone name (America/Chicago, Europe/London, Asia/Tokyo). Not a fixed
# offset: "UTC-6" is rejected, because a fixed offset is wrong twice a
# year. The container's own clock can stay UTC; only the day boundary
# moves.
#
# This is the variable that stops an evening entry written at 7pm from
# being filed under tomorrow. Without it the app used the process zone,
# which in a container is UTC, so a morning and an evening logged on the
# same night landed on two different days.
#
# Fails loudly: a name the runtime does not know stops the server at
# boot with the reason in the log, rather than quietly falling back to
# UTC. docker-compose.yml also hands this to Postgres, so the database
# and the app can never disagree about what day it is.
#
# Default when unset: America/Chicago.
LIFEOS_TIMEZONE=America/Chicago

# A testing seam, not a setting. An ISO instant that shifts the server's
# clock so that instant is "now". Prints a warning on every boot where
# it is set. Never set it in production.
# LIFEOS_FAKE_NOW=2026-11-07T23:30:00-06:00
